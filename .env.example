# Every variable is optional. The app runs with none of them; API keys for the
# model providers are entered in the app and never leave the browser.

# Product analytics (PostHog) stays off until this public project token is set
# at build time. Without it the SDK is not even downloaded and the /ingest proxy
# route is not registered.
# NEXT_PUBLIC_POSTHOG_KEY=

# Where the browser sends analytics. Defaults to the same-origin /ingest proxy,
# which Vercel or any Node host serves when a key is set. The GitHub Pages export
# has no proxy, so its deploy sets the PostHog host directly (the CSP is widened
# to match).
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
